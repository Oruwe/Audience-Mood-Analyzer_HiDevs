# ingestion/youtube.py (SPEC §1/§4.4) — public commentThreads.list pulls
# need only a plain API key, no OAuth
YOUTUBE_API_KEY=

# engine/stage_a.py, engine/llm_client.py's future OpenRouter chain (SPEC §7):
# all generative inference (Stage A/B/C) routes through OpenRouter.
OPENROUTER_API_KEY=

# storage/postgres.py (SPEC §4.3/§9) -- job state, checkpoints, the
# analysis cache. Production: a Neon or Supabase free-tier connection
# string. Local development: this sandbox's own Postgres 16
# (`service postgresql start`; matches the default storage/postgres.py's
# tests fall back to if this is left unset).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audience_mood_analyzer

GEMINI_API_KEY=
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: enables the Redis-backed dedup backend (leave unset for in-memory LRU)
#REDIS_URL=
