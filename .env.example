# ---------------------------------------------------------------------------
# Required — the app refuses to start an analysis without all three.
# ---------------------------------------------------------------------------

# ingestion/youtube.py (SPEC §1/§4.4). Public commentThreads.list pulls need
# only a plain API key -- no OAuth, no consent screen. Create one at
# console.cloud.google.com with the YouTube Data API v3 enabled.
# Free: 10,000 quota units/day.
YOUTUBE_API_KEY=

# All generative inference -- Stage A sentiment, Stage A embeddings, Stage B
# classification, Stage C synthesis -- routes through OpenRouter (SPEC §7).
# Get one at openrouter.ai/keys. A 500-comment analysis costs about $0.03.
OPENROUTER_API_KEY=

# storage/postgres.py (SPEC §4.3/§9) -- job state, checkpoints, the analysis
# cache. "One connection string, results survive redeploys" is the whole
# point: the same schema and driver work against a hosted Postgres or a local
# one, with no code change between them.
#   Production:  a Neon or Supabase free-tier connection string
#   Local:       the default below (`service postgresql start`, then
#                `createdb audience_mood_analyzer`)
# The schema creates itself on first connect; there is nothing to migrate.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audience_mood_analyzer


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set to 1 to run harness/preflight.py once per container at startup and log
# the full report to stdout. Off by default because it makes a handful of
# real (if tiny, ~$0.0002) model calls, and paying that on every cold start
# of a free-tier service that sleeps aggressively should be deliberate.
# Worth turning on in production: the deployed container's logs are often the
# only channel into how the live network path actually behaves.
#PREFLIGHT_ON_BOOT=1

# ingestion/youtube.py -- ingestion bounds. These are code defaults
# (MAX_COMMENTS_PER_VIDEO_DEFAULT = 70, MAX_REPLIES_PER_THREAD_DEFAULT = 5)
# rather than environment variables, and are listed here so the cost model is
# visible where the other cost knobs are:
#
#   * At most 70 comments per video, ordered by relevance ("top comments"),
#     so a video costs exactly ONE commentThreads.list page = 1 quota unit,
#     whether it has 70 comments or 700,000. A 50-video channel analysis
#     therefore costs ~53 units of the 10,000/day budget.
#   * At most 5 replies per thread, so one viral argument cannot fill the
#     per-video budget and crowd out every other commenter.
#
# Raising the per-video cap above 100 reintroduces multi-page pagination and
# makes quota cost scale with a video's popularity again. Change it in
# ingestion/youtube.py, where the reasoning sits next to the constant.

# ingestion/dedup.py. Switches deduplication from the default in-memory LRU
# to Redis. Only earns its keep across multiple processes -- this app runs as
# one, so leaving it unset is the normal case.
#REDIS_URL=

# Optional LLM tracing.
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_HOST=https://cloud.langfuse.com
